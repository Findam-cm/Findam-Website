VITE_GOOGLE_MAPS_API_KEY= exampleapikey

ADMIN EMAIL=findamadmin@gmail.com
ADMIN PASSWORD= findamadminpassword
 ROOT_ADMIN_EMAIL=findamrootadmin@gmail.com

# Listings and photos are stored in the Cloudflare R2 bucket findam-listings.
# Create it with: npx wrangler r2 bucket create findam-listings
# Then run npm run api beside npm run dev.

# `neon deploy` writes the real values into .env. Copy the server values into
# .env.api for the Worker. Never commit them, and never prefix the secret with VITE_.
# For local admin access, set ROOT_ADMIN_EMAIL in .env, then run:
# node scripts/sync-neon-env.mjs
# For the deployed Worker, set ROOT_ADMIN_EMAIL as a Cloudflare Worker secret.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_FUNCTION_HELLO_BASE_URL=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# Comma-separated browser origins allowed to call the API. Localhost is always allowed.
# The live site is also allowlisted in Neon Auth trusted domains.
ALLOWED_ORIGINS=https://usefindam.com,https://www.usefindam.com
SITE_URL=https://usefindam.com

# Restrict VITE_GOOGLE_MAPS_API_KEY in Google Cloud to the Maps Embed API
# and to the live site's HTTP referrer before the site is public.